# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before starting the server.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# Authentication & Token Security
# REQUIRED: In production, provide a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Python Executable for ML Model Inference & Evaluation
# Set to 'python' or 'python3' or full path to python virtualenv executable
PYTHON_BIN=python

# Optional External AI/LLM API Key (RAG Grounding & Chat)
# When left blank, system uses honest local knowledge retrieval without hallucinating
GEMINI_API_KEY=

# Optional Email / Notification Service (Reminders)
# When blank, reminders persist in-app without raising delivery errors
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gov-assistance-system.local
